# open-nav configuration
#
# Copy to .env (or .env.open-nav) and fill in. The CLI walks up from the
# working directory to find one, so a single file at the project root serves
# every subdirectory.
#
# These are secrets. .env is git-ignored; keep it that way, and prefer a real
# secret manager for production credentials.

# "test" or "production". Defaults to test — set production deliberately.
NAV_ENVIRONMENT=test

# Technical user (technikai felhasználó), created in the Online Számla portal.
# The test and production systems issue separate, non-interchangeable users.
NAV_LOGIN=
NAV_PASSWORD=
NAV_SIGN_KEY=
NAV_EXCHANGE_KEY=

# The taxpayer being reported for: the 8 digit core tax number (törzsszám),
# NOT the 11 digit form. Pasting 12345678-2-41 here is the most common setup
# mistake, and NAV reports it only as INVALID_SECURITY_USER.
NAV_TAX_NUMBER=

# Identifies your software to NAV. The id must be 18 characters.
NAV_SOFTWARE_ID=
NAV_SOFTWARE_NAME=open-nav
NAV_SOFTWARE_VERSION=0.1.0
NAV_SOFTWARE_OPERATION=LOCAL_SOFTWARE
NAV_SOFTWARE_DEV_NAME=
NAV_SOFTWARE_DEV_CONTACT=
NAV_SOFTWARE_DEV_TAX_NUMBER=

# Only for pointing at a mock server during development.
# NAV_BASE_URL=http://localhost:8080/invoiceService/v1
