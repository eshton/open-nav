  "homepage": "https://github.com/eshton/open-nav#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshton/open-nav.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/eshton/open-nav/issues",
  "type": "module",
  "main": "./dist/index.js",
