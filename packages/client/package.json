{
  "name": "@open-nav/client",
  "version": "0.1.0",
  "description": "API client for the Hungarian Tax Authority (NAV) Online Számla 3.0 invoice service",
  "keywords": [
    "nav",
    "onlineszamla",
    "online-szamla",
    "hungary",
    "invoice",
    "einvoice",
    "tax",
    "api"
  ],
  "license": "MIT",
  "author": "open-nav contributors",
  "homepage": "https://github.com/eshton/open-nav#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshton/open-nav.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/eshton/open-nav/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@open-nav/core": "workspace:^"
  }
}
