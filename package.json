{
  "name": "open-nav",
  "version": "0.1.0",
  "private": true,
  "description": "Open source libraries and tools for the Hungarian Tax Authority (NAV) Online Sz\u00e1mla API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b packages/codegen packages/core",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "typecheck": "tsc -b --force packages/codegen packages/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test",
    "codegen": "tsc -b packages/codegen && node packages/codegen/dist/main.js && prettier --write --log-level warn packages/core/src/generated",
    "codegen:check": "pnpm codegen && git diff --exit-code -- packages/core/src/generated"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
